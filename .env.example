# ollama = local only; auto = local first with OpenAI fallback; openai = OpenAI only
LLM_PROVIDER=ollama

# Primary address. The server also auto-detects 127.0.0.1:12000 and 127.0.0.1:11434.
OLLAMA_BASE_URL=http://127.0.0.1:12000
OLLAMA_WRITING_MODEL=hf.co/unsloth/Qwen3.5-9B-GGUF:UD-Q4_K_XL
OLLAMA_WRITING_TIMEOUT_SECONDS=60

# Exercise generation is heavier than sentence checking.
# Generate in small batches so a 9B local model does not need to emit 12-20 questions in one response.
OLLAMA_GENERATION_TIMEOUT_SECONDS=180
OLLAMA_GENERATION_BATCH_SIZE=4

# Optional fallback
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-5.6-luna

PORT=5178
